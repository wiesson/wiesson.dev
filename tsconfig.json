{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["astro/client", "@cloudflare/workers-types", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$components/*": ["./src/components/*"],
      "$utils/*": ["./src/utils/*"],
      "$types/*": ["./src/types/*"],
      "$layouts/*": ["./src/layouts/*"]
    }
  }
}
