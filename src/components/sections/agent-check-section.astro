---
import type { Locale } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "de" } = Astro.props;
const t = getTranslations(lang);
// The machine-readable CV is not under the /en/ prefix — it is its own route.
const rawHref = lang === "en" ? "/cv/llm/en.md" : "/cv/llm/de.md";
---

<section class="app-grid py-12">
  <div class="app-text-column">
    <div class="flex flex-col gap-3.5">
      <h2 class="section-heading">{t.agentCheck.title}</h2>
      <p class="text-muted-foreground text-sm leading-relaxed">
        {t.agentCheck.intro}
      </p>

      <div class="agent-prompt">
        <pre class="agent-prompt-text">{t.agentCheck.prompt}</pre>
        <button
          type="button"
          class="agent-prompt-copy"
          data-label={t.agentCheck.copy}
          data-label-done={t.agentCheck.copied}
          aria-label={t.agentCheck.copy}
        >
          {t.agentCheck.copy}
        </button>
      </div>

      <p class="text-muted-foreground text-xs leading-relaxed">
        {t.agentCheck.note}{" "}
        <a href={rawHref} class="link-underline">{t.agentCheck.rawLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .agent-prompt {
    position: relative;
    border-radius: var(--radius);
    background-color: oklch(0.17 0 0);
    padding: 1rem 1rem 1rem 1.125rem;
    overflow: hidden;
  }

  .agent-prompt-text {
    margin: 0;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: oklch(0.93 0 0);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-right: 4.5rem;
  }

  .agent-prompt-copy {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    border: 1px solid oklch(1 0 0 / 15%);
    border-radius: calc(var(--radius) - 4px);
    background-color: oklch(1 0 0 / 8%);
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: oklch(0.85 0 0);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .agent-prompt-copy:hover {
    background-color: oklch(1 0 0 / 16%);
    color: oklch(0.98 0 0);
  }

  .agent-prompt-copy:focus-visible {
    outline: 2px solid var(--personal-accent);
    outline-offset: 2px;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".agent-prompt-copy")
    .forEach((button) => {
      const block = button.closest(".agent-prompt");
      const pre = block?.querySelector<HTMLElement>(".agent-prompt-text");
      const text = pre?.textContent;
      if (!pre || !text) return;

      const label = button.dataset.label ?? "Kopieren";
      const labelDone = button.dataset.labelDone ?? "Kopiert";
      let reset: ReturnType<typeof setTimeout>;

      const flash = (next: string) => {
        button.textContent = next;
        clearTimeout(reset);
        reset = setTimeout(() => {
          button.textContent = label;
        }, 2000);
      };

      // Falls die Clipboard-API nicht greift (kein sicherer Kontext, Safari,
      // fehlende Berechtigung): Text markieren, damit Cmd/Strg+C funktioniert.
      const selectInstead = () => {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      };

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          flash(labelDone);
        } catch {
          selectInstead();
          flash("⌘C");
        }
      });
    });
</script>
