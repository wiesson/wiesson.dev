---
import { getTranslations, type Locale } from "../../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "de" } = Astro.props;
const t = getTranslations(lang);

// Curated selection — the full stack lives in the CV. Rows reuse the same
// label-column layout as the work listing so both sections read as one system.
const skills: { label: string; items: string }[] =
  lang === "de"
    ? [
        {
          label: "Frontend",
          items:
            "TypeScript · React · Next.js · Svelte · Astro · Tailwind CSS · shadcn/ui",
        },
        {
          label: "Backend",
          items: "Node.js · Python · Golang · REST & GraphQL · Serverless",
        },
        {
          label: "KI",
          items:
            "Claude & OpenAI APIs · RAG & Vector Search · Agent-Workflows · Datenintegration",
        },
        {
          label: "Daten",
          items: "PostgreSQL · Supabase · Convex · MongoDB · Firebase",
        },
        {
          label: "Infrastruktur",
          items: "Cloudflare · Vercel · Docker · CI/CD · GitHub Actions · Resend",
        },
        {
          label: "Arbeitsweise",
          items:
            "Remote-first · Code Reviews · Testing (Playwright, Jest) · Technische Dokumentation",
        },
      ]
    : [
        {
          label: "Frontend",
          items:
            "TypeScript · React · Next.js · Svelte · Astro · Tailwind CSS · shadcn/ui",
        },
        {
          label: "Backend",
          items: "Node.js · Python · Golang · REST & GraphQL · Serverless",
        },
        {
          label: "AI",
          items:
            "Claude & OpenAI APIs · RAG & vector search · agent workflows · data integration",
        },
        {
          label: "Data",
          items: "PostgreSQL · Supabase · Convex · MongoDB · Firebase",
        },
        {
          label: "Infrastructure",
          items: "Cloudflare · Vercel · Docker · CI/CD · GitHub Actions · Resend",
        },
        {
          label: "Ways of working",
          items:
            "Remote-first · code reviews · testing (Playwright, Jest) · technical documentation",
        },
      ];
---

<section id="technologies" class="app-grid py-12 scroll-mt-16">
  <div class="app-text-column">
    <h2 class="section-heading mb-8">{t.sections.technologies}</h2>

    <dl class="space-y-4 text-sm">
      {
        skills.map(({ label, items }) => (
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="shrink-0 sm:w-32 cv-text-meta">{label}</dt>
            <dd class="cv-text-primary">{items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
