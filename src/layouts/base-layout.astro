---
import "../styles/base.css";

import SiteNav from "$components/layout/site-nav.astro";
import PageHeader from "$components/layout/page-header.astro";
import SiteFooter from "$components/layout/site-footer.astro";
import { getTranslations } from "../i18n";
import type { Locale } from "../i18n";

const isProd = import.meta.env.PROD;

type HeaderType = "nav" | "page" | "none";

interface Props {
  lang?: Locale;
  headerType?: HeaderType;
  pageTitle?: string;
  title?: string;
  description?: string;
}

const {
  lang = "de",
  headerType = "nav",
  pageTitle = "",
  title,
  description,
} = Astro.props;
const t = getTranslations(lang);
const metaTitle = title ?? t.meta.title;
const metaDescription = description ?? t.meta.description;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {headerType === "nav" && <SiteNav lang={lang} />}
    {headerType === "page" && <PageHeader lang={lang} title={pageTitle} />}

    <main class="space-y-8 md:space-y-16">
      <slot />
    </main>

    <SiteFooter lang={lang} currentPath={Astro.url.pathname} />

    {isProd && <script data-domain="arnewiese.de" src="/js/script.js" />}
  </body>
</html>
