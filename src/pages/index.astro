---
import BaseLayout from "$layouts/base-layout.astro";
import Button from "$components/ui/button.astro";
import ServicesSection from "$components/sections/services-section.astro";
import ProductsReferenceSection from "$components/sections/products-reference-section.astro";
import AgentCheckSection from "$components/sections/agent-check-section.astro";
import ClientsSection from "$components/sections/clients-section.astro";
import StationsSection from "$components/sections/stations-section.astro";
import TechnologiesSection from "$components/sections/technologies-section.astro";

const lang = "de";
---


<BaseLayout lang={lang}>
  <section class="app-grid hero-section">
    <article class="app-text-column">
      <div class="space-y-6">
        <h1 class="hero-title">
          Freiberuflicher Software Engineer für Web, iOS und KI-Agenten
        </h1>

        <div class="hero-copy space-y-5">
          <p>
            Seit 2019 arbeite ich freiberuflich als Software Engineer. Ich entwickle Webanwendungen, native Apps für iPhone und Mac und Systeme mit KI-Agenten. Außerdem berate ich bei Architektur-Entscheidungen, technischen Audits und der Modernisierung bestehender Systeme.
          </p>

          <p>
            Aktuell arbeite ich für einen großen Beauty-Händler (Retail Media) und einen Düsseldorfer Anbieter für Marketing-Attribution. Davor unter anderem für <a
              href="https://frontnow.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Frontnow</a
            >, <a
              href="https://energybox.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Energybox</a
            > und <a
              href="https://sipgate.de"
              target="_blank"
              rel="noopener"
              class="link-underline">sipgate</a
            >.
          </p>

          <p>
            Ende 2025 habe ich <a
              href="https://www.nordwerk.studio"
              target="_blank"
              rel="noopener"
              class="link-underline">Studio Nordwerk</a
            > gegründet. Projekte als Freiberufler nehme ich weiter an. Im Studio entstehen daneben eigene Produkte und Websites im Abo.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="mailto:arne@wiese.me?subject=Projektanfrage" size="lg">Projekt anfragen</Button>
          <a
            href="/cv"
            class="text-foreground link-underline inline-flex items-center gap-1 text-sm font-medium"
          >
            Lebenslauf ansehen
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </article>
  </section>

  <ServicesSection lang={lang} />
  <AgentCheckSection lang={lang} />
  <ClientsSection lang={lang} />
  <StationsSection lang={lang} />
  <TechnologiesSection lang={lang} />
  <ProductsReferenceSection lang={lang} />
</BaseLayout>
