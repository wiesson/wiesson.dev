---
import BaseLayout from "$layouts/base-layout.astro";
import ServicesSection from "$components/sections/services-section.astro";
import ProductsReferenceSection from "$components/sections/products-reference-section.astro";
import ClientsSection from "$components/sections/clients-section.astro";
import CvWorkListing from "$components/cv/cv-work-listing.astro";
import TechnologiesSection from "$components/sections/technologies-section.astro";
import { getCollection } from "astro:content";
import { getTranslations } from "../i18n";

const lang = "de";
const t = getTranslations(lang);
const cvWork = await getCollection("work");

const now = new Date();

cvWork.sort((a, b) => {
  const toA = a.data.to === "now" ? now : a.data.to;
  const toB = b.data.to === "now" ? now : b.data.to;
  return toB.getTime() - toA.getTime();
});

const mainWork = cvWork.filter((item) => item.data.type === "main");
const sideProjects = cvWork.filter((item) => item.data.type === "side");
---

<BaseLayout lang={lang}>
  <section class="app-grid hero-section">
    <article class="app-text-column">
      <div class="space-y-6">
        <h1 class="hero-title">
          Freier Entwickler für Web-Technologien, APIs und KI-Lösungen
        </h1>

        <div class="hero-copy space-y-5">
          <p>
            Ich bin freiberuflicher Senior Software Engineer und entwickle
            Webapplikationen, SaaS-Produkte und KI-Lösungen. Zudem berate ich bei
            Architektur-Entscheidungen, technischen Audits und der
            Modernisierung bestehender Systeme.
          </p>

          <p>
            In den letzten Jahren habe ich u.a. bei <a
              href="https://frontnow.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Frontnow</a
            >, <a
              href="https://douglas.de"
              target="_blank"
              rel="noopener"
              class="link-underline">Parfümerie Douglas</a
            >, <a
              href="https://energybox.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Energybox</a
            > und <a
              href="https://sipgate.de"
              target="_blank"
              rel="noopener"
              class="link-underline">sipgate</a
            > gearbeitet.
          </p>

          <p>
            Ende 2025 habe ich <a
              href="https://nordwerk.studio"
              target="_blank"
              rel="noopener"
              class="link-underline">Studio Nordwerk</a
            > gegründet, ein AI- und Software-Studio für pragmatische SaaS-Lösungen
            und schnelle MVPs.
          </p>
        </div>
      </div>
    </article>
  </section>

  <ServicesSection lang={lang} />
  <ProductsReferenceSection lang={lang} />
  <ClientsSection lang={lang} />

  <CvWorkListing
    title={t.sections.experience}
    subtitle={t.sections.experienceNote}
    items={mainWork}
    lang={lang}
    showBadges={false}
    showYearsOnly
  />

  <CvWorkListing
    title={t.sections.sideProjects}
    items={sideProjects}
    lang={lang}
    showBadges={false}
    showYearsOnly
  />

  <TechnologiesSection lang={lang} />
</BaseLayout>
