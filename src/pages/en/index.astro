---
import BaseLayout from "$layouts/base-layout.astro";
import Button from "$components/ui/button.astro";
import ServicesSection from "$components/sections/services-section.astro";
import ProductsReferenceSection from "$components/sections/products-reference-section.astro";
import AgentCheckSection from "$components/sections/agent-check-section.astro";
import ClientsSection from "$components/sections/clients-section.astro";
import StationsSection from "$components/sections/stations-section.astro";
import TechnologiesSection from "$components/sections/technologies-section.astro";

const lang = "en";
---


<BaseLayout lang={lang}>
  <section class="app-grid hero-section">
    <article class="app-text-column">
      <div class="space-y-6">
        <h1 class="hero-title">
          Freelance software engineer for web, iOS and AI agents
        </h1>

        <div class="hero-copy space-y-5">
          <p>
            I have been working as a freelance software engineer since 2019. I build web applications, native apps for iPhone and Mac, and systems with AI agents. I also advise on architecture decisions, technical audits and the modernisation of existing systems.
          </p>

          <p>
            I currently work for a large European beauty retailer (retail media) and a marketing attribution company based in Düsseldorf. Before that, among others, for <a
              href="https://frontnow.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Frontnow</a
            >, <a
              href="https://energybox.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Energybox</a
            > and <a
              href="https://sipgate.de"
              target="_blank"
              rel="noopener"
              class="link-underline">sipgate</a
            >.
          </p>

          <p>
            In late 2025 I founded <a
              href="https://www.nordwerk.studio"
              target="_blank"
              rel="noopener"
              class="link-underline">Studio Nordwerk</a
            >. I continue to take on freelance projects. Alongside, the studio builds its own products and subscription websites.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="mailto:arne@wiese.me?subject=Project%20request" size="lg">Request a project</Button>
          <a
            href="/en/cv"
            class="text-foreground link-underline inline-flex items-center gap-1 text-sm font-medium"
          >
            View résumé
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </article>
  </section>

  <ServicesSection lang={lang} />
  <AgentCheckSection lang={lang} />
  <ClientsSection lang={lang} />
  <StationsSection lang={lang} />
  <TechnologiesSection lang={lang} />
  <ProductsReferenceSection lang={lang} />
</BaseLayout>
