---
import BaseLayout from "$layouts/base-layout.astro";
import ServicesSection from "$components/sections/services-section.astro";
import ProductsReferenceSection from "$components/sections/products-reference-section.astro";
import CvWorkListing from "$components/cv/cv-work-listing.astro";
import TechnologiesSection from "$components/sections/technologies-section.astro";
import { getCollection } from "astro:content";
import { getTranslations } from "../../i18n";

const lang = "en";
const t = getTranslations(lang);
const cvWork = await getCollection("work-en");

const now = new Date();

cvWork.sort((a, b) => {
  const toA = a.data.to === "now" ? now : a.data.to;
  const toB = b.data.to === "now" ? now : b.data.to;
  return toB.getTime() - toA.getTime();
});

const recentMainWork = cvWork
  .filter((item) => item.data.type === "main")
  .slice(0, 5);
---

<BaseLayout lang={lang}>
  <!-- CV link - absolute top right -->
  <a
    href="/en/cv"
    class="text-muted-foreground hover:text-foreground link-underline fixed top-4 right-4 z-50 text-sm font-medium transition-colors"
  >
    {t.nav.cv}
  </a>

  <section class="app-grid hero-section">
    <article class="app-text-column">
      <div class="space-y-6">
        <h1 class="hero-title">
          Freelance developer for web technologies, APIs, and AI solutions
        </h1>

        <div class="hero-copy space-y-5">
          <p>
            I am a freelance Senior Software Engineer building web applications,
            SaaS products, and AI solutions. Since February 2026, I have been
            supporting Exactag in Düsseldorf as an external Senior Software
            Engineer with a focus on AI.
          </p>

          <p>
            In recent years I've worked with <a
              href="https://frontnow.com"
              target="_blank"
              rel="noopener"
              class="link-underline">Frontnow</a
            >, <a
              href="https://douglas.de"
              target="_blank"
              rel="noopener"
              class="link-underline">Parfümerie Douglas</a
            >, <a
              href="https://carauktion.de"
              target="_blank"
              rel="noopener"
              class="link-underline">carauktion</a
            > and <a
              href="https://sipgate.de"
              target="_blank"
              rel="noopener"
              class="link-underline">sipgate</a
            >.
          </p>

          <p>
            In late 2025 I founded <a
              href="https://nordwerk.studio"
              target="_blank"
              rel="noopener"
              class="link-underline">Studio Nordwerk</a
            >, an AI and software studio focused on pragmatic SaaS solutions and
            rapid MVPs.
          </p>
        </div>
      </div>
    </article>
  </section>

  <ServicesSection lang={lang} />
  <ProductsReferenceSection lang={lang} />

  <CvWorkListing
    title={t.sections.workExperience}
    items={recentMainWork}
    lang={lang}
    showIntro
    showBadges={false}
    showYearsOnly={true}
    viewAllLink={{
      href: "/en/cv",
      label: t.about.viewFullCv,
    }}
  />

  <TechnologiesSection lang={lang} />
</BaseLayout>
